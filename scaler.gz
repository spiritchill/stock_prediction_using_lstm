MinMaxScaler(
    feature_range = (0, 1),      # scales all values between 0 and 1

    data_min_  = [min of Close, min of Volume, min of Return,
                  min of MA_10, min of MA_50, min of Volatility],

    data_max_  = [max of Close, max of Volume, max of Return,
                  max of MA_10, max of MA_50, max of Volatility],

    scale_     = [scale factor for each of the 6 features],
    n_features_ = 6
)
